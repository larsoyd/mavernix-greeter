[Unit]
Description=Install the login screen look exported by %i

[Service]
Type=oneshot
ExecStart=/usr/bin/mavernix-greeter-sync import %i
TimeoutStartSec=120
UMask=0022
ProtectSystem=strict
ReadWritePaths=-/var/lib/mavernix-greeter/theme
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
MemoryMax=512M
TasksMax=16
