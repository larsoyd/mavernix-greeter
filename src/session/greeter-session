#!/usr/bin/env bash
# greetd runs this as the greeter user: a private Wayfire with the greeter, or a text login if that fails
set -uo pipefail

lib=${MAVENIX_GREETER_LIBDIR:-/usr/lib/mavenix-greeter}
share=${MAVENIX_GREETER_DATADIR:-/usr/share/mavenix-greeter}
state=${MAVENIX_GREETER_STATEDIR:-/var/lib/mavenix-greeter}
fallback=${MAVENIX_GREETER_FALLBACK:-$lib/text-greeter}

log() { printf '[greeter-session] %s\n' "$*" >&2; }

if [[ -t 1 ]]; then
  if command -v systemd-cat >/dev/null; then
    exec > >(exec systemd-cat -t mavenix-greeter) 2>&1
  else
    exec >/dev/null 2>&1
  fi
fi

[[ -n ${XDG_RUNTIME_DIR:-} && -d $XDG_RUNTIME_DIR && -O $XDG_RUNTIME_DIR ]] || {
  log "result=fallback reason=no_runtime_dir"
  exec "$fallback"
}
run=$XDG_RUNTIME_DIR/mavenix-greeter
if ! { rm -rf "$run" && mkdir -m 700 "$run"; }; then
  log "result=fallback reason=run_dir"
  exec "$fallback"
fi

theme=$share/themes/neutral
[[ -r $state/theme/current/theme.json ]] && theme=$state/theme/current
export MAVENIX_GREETER_THEME_DIR=$theme
export MAVENIX_GREETER_HELPER=$lib/helper
export MAVENIX_GREETER_STATUS=$run/status
export XDG_CACHE_HOME=$run/cache XDG_STATE_HOME=$run/state XDG_DATA_HOME=$run/data XDG_CONFIG_HOME=$run/config
export QS_DISABLE_CRASH_HANDLER=1 WLR_LOG=${WLR_LOG:-error}
export XCURSOR_PATH=$theme/cursors:/usr/local/share/icons:/usr/share/icons
unset DISPLAY WAYLAND_DISPLAY

if timeout 10 "$lib/helper" fontconfig --theme-dir "$theme" --cache "$run/fontconfig" > "$run/fonts.conf"; then
  export FONTCONFIG_FILE=$run/fonts.conf
fi

if [[ -z ${WLR_DRM_DEVICES:-} ]]; then
  drm=$(timeout 10 "$lib/helper" drm-device --theme-dir "$theme") && [[ -n $drm ]] && export WLR_DRM_DEVICES=$drm
fi
main=$(timeout 10 python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1])).get("display",{}).get("main_output",""))' \
  "$theme/theme.json" 2>/dev/null) && export MAVENIX_GREETER_MAIN_OUTPUT=$main

if ! timeout 10 "$lib/helper" compositor --theme-dir "$theme" --client "$lib/run-greeter" > "$run/wayfire.ini"; then
  log "result=fallback reason=compositor_config"
  exec "$fallback"
fi

started=$(date +%s%N)
# the compositor keeps this pid through exec, its clients need it to stop it
# shellcheck disable=SC2016
bash -c 'export MAVENIX_GREETER_WAYFIRE_PID=$$; exec setpriv --pdeathsig KILL -- "$@"' greeter \
  "${MAVENIX_GREETER_COMPOSITOR:-wayfire}" -c "$run/wayfire.ini" &
wf=$!
echo "$wf" > "$run/compositor.pid"
stopping=0
trap 'stopping=1; kill -TERM "$wf" 2>/dev/null' TERM INT HUP
while kill -0 "$wf" 2>/dev/null; do
  wait "$wf"
done
wait "$wf" 2>/dev/null
rc=$?
status=$(cat "$run/status" 2>/dev/null || echo none)
log "compositor_exit=$rc status=$status ms=$(( ($(date +%s%N) - started) / 1000000 ))"
[[ $status == launched ]] && exit 0
(( stopping )) && exit 0
log "result=fallback reason=greeter_$status"
exec "$fallback"
